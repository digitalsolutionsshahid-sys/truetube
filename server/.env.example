# ==============================================================================
# TrueTube Production & Development Environment Configuration
# ==============================================================================

# Server Network & Host Binding
TRUETUBE_HOST=0.0.0.0
TRUETUBE_PORT=8000
TRUETUBE_DEBUG=false

# CORS Configuration (comma-separated list of allowed origins, or * for open)
TRUETUBE_ALLOWED_ORIGINS=*

# Media Pipeline Concurrency & Safety Limits
# Maximum concurrent worker download jobs processing simultaneously
TRUETUBE_MAX_JOBS=5

# Job execution timeout in seconds (default: 900s = 15 minutes)
TRUETUBE_JOB_TIMEOUT=900

# File expiration TTL in seconds (default: 3600s = 1 hour).
# Completed files and directories are automatically purged after this interval.
TRUETUBE_FILE_TTL=3600

# Explicit paths to system binaries (leave empty for automatic detection via system PATH)
FFMPEG_PATH=
FFPROBE_PATH=
